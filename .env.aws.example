# AWS RDS source configuration. Copy with `npm run aws:env:init`; never commit
# the generated .env.aws file or paste its secrets into chat.
NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://hr.example.com
COOKIE_SECURE=true
ENCRYPTION_KEY=

# Values visible in the supplied RDS console screenshot (Mumbai/ap-south-1).
AWS_RDS_HOST=database-1.c3a6e2caw01a.ap-south-1.rds.amazonaws.com
AWS_RDS_PORT=5432
AWS_RDS_ADMIN_DATABASE=postgres
AWS_RDS_DATABASE=defence_garden_hr
AWS_RDS_ADMIN_USER=postgres
AWS_RDS_ADMIN_PASSWORD=
AWS_RDS_CA_URL=https://truststore.pki.rds.amazonaws.com/ap-south-1/ap-south-1-bundle.pem
AWS_RDS_CA_FILE=.local/aws-rds/ap-south-1-bundle.pem

# Organization bound to this branded deployment. Login screens do not ask for it.
LOGIN_ORGANIZATION_ID=10000000-0000-4000-8000-000000000001

# Generated by aws:env:init. These stay distinct to preserve RLS boundaries.
RUNTIME_DB_PASSWORD=
AUTH_DB_PASSWORD=
WORKER_DB_PASSWORD=
# Set true only when deliberately rotating all three existing application roles.
AWS_RDS_ROTATE_APP_ROLE_PASSWORDS=false

# Fill these with Render Key Value, private S3 and authenticated SMTP services.
# aws:env:render:cloud rejects local services and writes Render-safe CA paths.
REDIS_URL=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=hr@example.com
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
CLAMAV_HOST=
CLAMAV_PORT=3310
FCM_SERVICE_ACCOUNT_FILE=

# DWR agent (worker only): prepares each employee's DWR from their chat messages.
# Never expose keys through VITE_ or Flutter assets. The API keeps
# OPENROUTER_API_KEY only for the separate analytics explanation.
OPENROUTER_API_KEY=
OPENROUTER_DWR_MODEL=
# Optional: pin one provider (no fallbacks); empty lets OpenRouter route among
# providers that support JSON Schema output with data collection denied.
OPENROUTER_DWR_PROVIDER=
# Optional daily call budgets (defaults 24 per employee, 2000 per organization).
DWR_AGENT_USER_DAILY_CALLS=
DWR_AGENT_ORG_DAILY_CALLS=
