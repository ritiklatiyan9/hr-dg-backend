NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5180
# Local HTTP only. Production enforces true and HTTPS.
COOKIE_SECURE=false
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
RUNTIME_DB_PASSWORD=
AUTH_DB_PASSWORD=
WORKER_DB_PASSWORD=
DATABASE_URL=postgresql://hr_runtime:REPLACE@localhost:55432/hr_local
AUTH_DATABASE_URL=postgresql://hr_auth:REPLACE@localhost:55432/hr_local
# Single organization bound to this branded deployment. Login forms never ask users for it.
LOGIN_ORGANIZATION_ID=10000000-0000-4000-8000-000000000001
WORKER_DATABASE_URL=postgresql://hr_worker:REPLACE@localhost:55432/hr_local
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE@localhost:55432/hr_local
TEST_MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE@localhost:55432/hr_test
TEST_DATABASE_URL=postgresql://hr_runtime:REPLACE@localhost:55432/hr_test
TEST_AUTH_DATABASE_URL=postgresql://hr_auth:REPLACE@localhost:55432/hr_test
REDIS_URL=redis://localhost:56379
S3_ENDPOINT=http://localhost:59000
S3_ACCESS_KEY=hr-local
S3_SECRET_KEY=
S3_BUCKET=hr-private
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_FROM=hr@example.test
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SEED_PASSWORD=
# DWR agent (worker only): prepares each employee's DWR from their chat messages.
# Never expose keys through VITE_ or Flutter assets. The API keeps
# OPENROUTER_API_KEY only for the separate analytics explanation.
OPENROUTER_API_KEY=
# Choose openrouter (default) or groq for the separate DWR worker.
DWR_AI_PROVIDER=openrouter
OPENROUTER_DWR_MODEL=
GROQ_API_KEY=
GROQ_DWR_MODEL=
# Optional: pin one provider (no fallbacks); empty lets OpenRouter route among
# providers that support JSON Schema output with data collection denied.
OPENROUTER_DWR_PROVIDER=
# Optional daily call budgets (defaults 24 per employee, 2000 per organization).
DWR_AGENT_USER_DAILY_CALLS=
DWR_AGENT_ORG_DAILY_CALLS=
OPENROUTER_ANALYTICS_MODEL=
OPENROUTER_ANALYTICS_PROVIDER=
# The API can use Groq for management explanations; DWR still needs a worker.
ANALYTICS_AI_PROVIDER=openrouter
GROQ_ANALYTICS_MODEL=
ANALYTICS_PROVIDER_REVIEWED_AT=
ANALYTICS_USER_DAILY_CALLS=
ANALYTICS_ORG_DAILY_CALLS=
ANALYTICS_CONCURRENCY=
# Serve the built HR panel from the API origin in Docker/staging.
SERVE_WEB=false
# Optional actual malware scanner; absent scanner keeps PDFs quarantined.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Server-side Google service-account JSON path. Never place its private key in Flutter.
FCM_SERVICE_ACCOUNT_FILE=
